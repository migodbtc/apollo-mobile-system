{
  "expo": {
    "name": "Apollo Mobile",
    "slug": "apollo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/BW.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons/APP-COLOR-SCHEME.png",
        "backgroundColor": "#020617"
      },
      "package": "com.anonymous.ApolloExpo",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "androidNavigationBar": {
      "backgroundColor": "#020617",
      "barStyle": "light-content",
      "visible": "leanback"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icons/APP-COLOR-SCHEME.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Apollo Mobile App to access your camera",
          "microphonePermission": "Allow Apollo Mobile App to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Apollo Mobile App to access your photos"
        }
      ],
      "expo-video",
      "expo-web-browser",
      "expo-audio",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "SERVER_LINK": "http://52.77.240.6:5821",
      "router": {},
      "eas": {
        "projectId": "75a19e08-ef61-4886-ae9a-367845b82a12"
      }
    }
  }
}
